## Reusable text fragments
brew text_empty = ""
brew text_space = " "
brew text_tab = "\t"
brew text_newline = "\n"
brew text_comma = ","
brew text_period = "."
brew text_colon = ":"
brew text_semicolon = ";"
brew text_dash = "-"
brew text_underscore = "_"
brew text_slash = "/"
brew text_backslash = "\\"
brew text_open_parenthesis = "("
brew text_close_parenthesis = ")"
brew text_open_bracket = "["
brew text_close_bracket = "]"
