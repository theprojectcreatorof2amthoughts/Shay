## Common source-code and math symbols
brew symbols_plus = "+"
brew symbols_minus = "-"
brew symbols_multiply = "*"
brew symbols_divide = "/"
brew symbols_equals = "="
brew symbols_not = "!"
brew symbols_less = "<"
brew symbols_greater = ">"
brew symbols_and = "&"
brew symbols_or = "|"
brew symbols_dollar = "$"
brew symbols_at = "@"
brew symbols_percent = "%"
brew symbols_question = "?"
brew symbols_arrow = "->"
