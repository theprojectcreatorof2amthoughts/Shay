## Decimal ASCII codes
brew ascii_null = 0
brew ascii_tab = 9
brew ascii_line_feed = 10
brew ascii_carriage_return = 13
brew ascii_space = 32
brew ascii_exclamation = 33
brew ascii_quote = 34
brew ascii_hash = 35
brew ascii_comma = 44
brew ascii_hyphen = 45
brew ascii_period = 46
brew ascii_zero = 48
brew ascii_nine = 57
brew ascii_upper_a = 65
brew ascii_upper_z = 90
brew ascii_lower_a = 97
brew ascii_lower_z = 122
