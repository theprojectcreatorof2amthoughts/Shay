brew displayName = "Windows guest"
$useentry reginit
$useentry advsynt
$useentry exprinit
$useentry varinit
$useentry uiinit

!%#csElementapp <{
    *#uiContrl "windows-mouzutil.shuil"

    *!#classUideclr !u#desktopPanel
        $uiSet 0
        $declrmthd doCalc
            insval/>displayName
        finish
    finish

    *!#doUiclass <"!u#desktopPanel">
}>
$dothis
$uiFinish
