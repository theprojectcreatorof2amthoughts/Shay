brew displayName = "Guest"
$useentry reginit
$useentry advsynt
$useentry exprinit
$useentry varinit
$useentry uiinit

!%#browsElementapp <{
    *#uiContrl "browserutil.shuil"
    *!#classUideclr !u#browserCalc
        $uiSet 0
        $declrmthd doCalc
            insval/>displayName
        finish
    finish
    *!#doUiclass <"!u#browserCalc">
    *#drawui <'square'> <<'568xx654'>>
    *#drawui <'buttoncircle'> <:onclick=doCalc:>
}>
$dothis
$uiFinish
