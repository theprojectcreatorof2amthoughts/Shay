brew displayName = "Windows guest"
$useentry reginit
$useentry advsynt
$useentry exprinit
$useentry varinit
$useentry uiinit

!%#csElementapp <{
    *#uiContrl "windowsutil.shuil"
    *!#classUideclr !u#desktopPanel
        $uiSet 0
        $declrmthd doCalc
            insval/>displayName
        finish
    finish
    *!#doUiclass <"!u#desktopPanel">
    *#drawui <'square'> <<'mainPanel'>>
    *#drawui <'buttoncircle'> <<'launchButton'>> <:onclick=doCalc:>
    *#drawui <'label'> <<'statusLabel'>> <:bind=displayName:>
    *#drawui <'textbox'> <<'nameInput'>> <:bind=displayName:>
    *#drawui <'checkbox'> <<'enableOption'>>
}>
$dothis
$uiFinish
