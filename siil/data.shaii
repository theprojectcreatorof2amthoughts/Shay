## Common data delimiters
brew data_csv_separator = ","
brew data_tsv_separator = "\t"
brew data_json_quote = "\\""
brew data_json_object_open = "{"
brew data_json_object_close = "}"
brew data_json_array_open = "["
brew data_json_array_close = "]"
brew data_key_value_separator = ":"
brew data_record_separator = "\n"
